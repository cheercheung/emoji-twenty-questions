# =====================================================================
#  Emoji 二十问 环境配置
#  用法：cp .env.example .env，然后按需修改。改完需要重启服务才生效。
#  除 EVOLINK_API_KEY 外，其余变量都有默认值，删掉或留空即用默认值。
# =====================================================================


# ---------------------------------------------------------------------
# EVOLINK_API_KEY   【必填】EvoLink 网关密钥
# ---------------------------------------------------------------------
# 取值：EvoLink 控制台（https://evolink.ai/dashboard/keys）里生成的 API Key，通常以 sk- 开头
# 说明：未填写时服务仍能启动，但页面顶部会提示，任何对局都会在第一步报错
EVOLINK_API_KEY=your_key_here


# ---------------------------------------------------------------------
# EVOLINK_BASE_URL   网关地址（不带结尾斜杠，不带 /v1）
# ---------------------------------------------------------------------
# 可选值：
#   https://direct.evolink.ai   默认。文本模型专用线路，长连接更稳
#   https://api.evolink.ai      备用线路（多模态主线路），direct 不通时换这个
#   http://127.0.0.1:8901       本地模拟网关，用于离线调试（本机地址不走系统代理）
# 说明：程序会在此地址后拼接 /v1/messages（Claude）或 /v1/chat/completions（GPT）
EVOLINK_BASE_URL=https://direct.evolink.ai


# ---------------------------------------------------------------------
# JUDGE_MODEL   默认裁判模型（自动单局 / 批量测试 / 命令行脚本用）
# ---------------------------------------------------------------------
# 可选值（必须是 app/config.py 里 MODELS 注册过的 ID）：
#   claude-opus-5-5      Claude Opus 5.5    最强，也最贵
#   claude-sonnet-5-5    Claude Sonnet 5.5  默认。速度与判断力折中
#   claude-fable-5-1     Claude Fable 5.1
#   gpt-6.1-sol          GPT-6.1 Sol
#   gpt-6-astra          GPT-6 Astra
# 说明：裁判只回答 yes 或 no，用便宜快速的模型即可；
#       页面上的下拉框可以临时覆盖这里的值。
#       要新增模型，去 app/config.py 的 MODELS 列表里加一行。
JUDGE_MODEL=claude-sonnet-5-5


# ---------------------------------------------------------------------
# QUESTION_LANGUAGE   猜测模型提问的默认语言（仅命令行批量脚本使用）
# ---------------------------------------------------------------------
# 可选值：任意自然语言名称，原样写进提示词，例如：
#   中文        默认
#   English
#   日本語
#   繁體中文
# 说明：网页上以右上角的 中文 / English 切换为准，会覆盖这里的值；
#       这里只对不经过网页的命令行批量脚本生效
QUESTION_LANGUAGE=中文


# ---------------------------------------------------------------------
# MAX_TURNS   每局回合上限
# ---------------------------------------------------------------------
# 可选值：正整数。经典玩法是 20
#   20    默认，标准二十问
#   10    更难，考验模型的二分效率
#   30    更宽松
# 说明：ask 和 guess 都消耗 1 回合；最后一回合会强制要求模型 guess
MAX_TURNS=20


# ---------------------------------------------------------------------
# LLM_TIMEOUT   单次模型调用超时（秒）
# ---------------------------------------------------------------------
# 可选值：正数（可带小数）
#   120   默认，足够大多数模型完成一次结构化输出
#   60    网络好、模型快时可以调低，让失败更快暴露
#   300   模型带长思考或网络较差时调高
# 说明：超时算一次失败，程序会自动重试 1 次；仍失败则对局进入 error 状态，
#       页面上可点"重试"继续同一局
LLM_TIMEOUT=120


# ---------------------------------------------------------------------
# EVOLINK_CREDIT_USD   1 个 EvoLink credit 折合多少美元
# ---------------------------------------------------------------------
# 可选值：正数
#   0.0147   默认，取自 EvoLink 定价页（1 credit ≈ $0.0147）
# 说明：花费取自 EvoLink 真实扣费（每次调用前后查询 /v1/credits 的差值，单位 credits），
#       页面同时显示 credits 和按此比例折算的美元。充值比例变化时改这里
EVOLINK_CREDIT_USD=0.0147
